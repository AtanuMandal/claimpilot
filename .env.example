# Copy this file to .env and fill in your values. Never commit .env.

# local | test | staging | production
APP_ENV=local

# Free key from Google AI Studio: https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# gemini-3.5-flash-lite (cheapest) or gemini-3.8-flash (strongest Flash model)
LLM_MODEL=gemini-3.5-flash-lite
